Proceso AREA_ELIPSE
    Definir ejeMayor, ejeMenor, area Como Real;

    Escribir "Ingrese el semieje mayor:";
    Leer ejeMayor;

    Escribir "Ingrese el semieje menor:";
    Leer ejeMenor;

    area <- PI * ejeMayor * ejeMenor;

    Escribir "El area de la elipse es: ", area;
FinProceso
